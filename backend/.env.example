# Demo works without credentials. Only server-side configuration belongs here.
LLM_API_KEY=
# Use a model ID supported by your provider/account.
LLM_MODEL=
# Optional comma-separated allowlist instead of LLM_MODEL:
LLM_MODELS=
LLM_BASE_URL=https://api.openai.com/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH=/absolute/path/to/playground.db
