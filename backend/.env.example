# Demo works without credentials. Only server-side configuration belongs here.
# Paste your Google AI Studio Gemini API key into backend/.env only.
LLM_API_KEY=
# Use a model ID supported by your provider/account.
LLM_MODEL=gemini-3.5-flash-lite
# Optional comma-separated allowlist instead of LLM_MODEL:
LLM_MODELS=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH=/absolute/path/to/playground.db
